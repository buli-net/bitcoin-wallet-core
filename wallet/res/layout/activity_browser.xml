<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/bg_action_bar">

        <!-- Vùng tiêu đề + 3 icon Home/Lịch sử/Cài đặt -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:background="@color/bg_action_bar">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/menu_web_browser"
        android:textColor="@color/fg_on_dark_bg_network_significant"
        android:textSize="20sp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <!-- Icon Home -->
    <ImageView
        android:id="@+id/btn_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_home_white_24dp"
        android:tint="@color/fg_on_dark_bg_network_significant"
        android:layout_marginStart="4dp"/>

    <!-- Icon Lịch sử -->
    <ImageView
        android:id="@+id/btn_history"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_history_white_24dp"
        android:tint="@color/fg_on_dark_bg_network_significant"
        android:layout_marginStart="4dp"/>

    <!-- Icon Cài đặt -->
    <ImageView
        android:id="@+id/btn_browser_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_settings_white_24dp"
        android:tint="@color/fg_on_dark_bg_network_significant"
        android:layout_marginStart="4dp"/>

</LinearLayout>


        <ImageView
            android:id="@+id/btn_back_web"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_24dp"
            android:tint="@color/fg_on_dark_bg_network_significant"
            android:background="?android:attr/selectableItemBackground" />

        <ImageView
            android:id="@+id/btn_forward_web"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_forward_24dp"
            android:tint="@color/fg_on_dark_bg_network_significant"
            android:background="?android:attr/selectableItemBackground" />

        <EditText
            android:id="@+id/url_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:hint="URL..."
            android:background="@drawable/edittext_background"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:padding="8dp"
            android:inputType="textUri"
            android:imeOptions="actionGo" />

        <ImageView
            android:id="@+id/btn_refresh_web"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_refresh_24dp"
            android:tint="@color/fg_on_dark_bg_network_significant"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
